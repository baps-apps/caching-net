{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Caching.NET": "Information"
    }
  },
  "AllowedHosts": "*",
  "CacheOptions": {
    "Enabled": true,
    "Mode": "Hybrid",
    "ApplicationPrefix": "sample-api",
    "DefaultExpiration": "00:10:00",

    "Entry": {
      "LocalExpiration": "00:03:00",
      "DistributedExpiration": "00:30:00",
      "EagerRefreshThreshold": 0.8,
      "JitterFraction": 0.1,
      "JitterMaxDuration": "00:00:02"
    },

    "Resilience": {
      "FailSafeEnabled": true,
      "FailSafeMaxDuration": "02:00:00",
      "FailSafeThrottleDuration": "00:00:30",
      "FactorySoftTimeout": "00:00:01",
      "FactoryHardTimeout": "00:00:10",
      "DistributedSoftTimeout": "00:00:00.500",
      "DistributedHardTimeout": "00:00:02",
      "AutoRecoveryEnabled": true
    },

    "Redis": {
      "Configuration": "localhost:6379,abortConnect=false",
      "Database": 0,
      "UseTls": false,
      "StrictCertificateValidation": true,
      "ConnectTimeout": "00:00:05",
      "CommandTimeout": "00:00:02"
    },

    "Backplane": {
      "Enabled": true
    },

    "Serialization": {
      "Format": "SystemTextJson",
      "MaximumPayloadBytes": 1048576,
      "Compression": {
        "Enabled": true,
        "ThresholdBytes": 16384,
        "MaximumDecompressedBytes": 16777216
      }
    },

    "Security": {
      "MaximumKeyLength": 512,
      "MaximumTagLength": 128,
      "MaximumTagCount": 16
    },

    "Observability": {
      "EnableTracing": true,
      "EnableMetrics": true,
      "LayerTracing": "WhenParented",
      "LogStartupSummary": true
    }
  }
}
