{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Caching.NET": "Debug"
    }
  },
  "CacheOptions": {
    "Mode": "InMemory",
    "DefaultExpiration": "00:01:00",
    "Redis": {
      "Configuration": null
    },
    "Backplane": {
      "Enabled": false
    },
    "Resilience": {
      "FailSafeEnabled": false,
      "ThrowOnDistributedCacheErrors": true,
      "ThrowOnSerializationErrors": true
    }
  }
}
