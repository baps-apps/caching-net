<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CodeStyle.NET" Version="1.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FsCheck" Version="3.3.4" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.4" />
    <!-- Pinned above the version the MessagePack serializer resolves transitively (3.1.4),
         which carries three high-severity advisories. -->
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Roslyn for the shipped analyzer. This sets the MINIMUM toolchain a consuming application
         needs to load the analyzer, so it must stay at or below the compiler in the oldest SDK a
         consumer may build with — never at the newest available version.
         5.6.0 was too new: the .NET 10.0.100 SDK pinned in global.json runs Roslyn 5.0.0.0, so an
         analyzer built against 5.6.0.0 made every consuming build fail outright with
         "error CS9057: Analyzer assembly ... references version '5.6.0.0' of the compiler, which is
         newer than the currently running version '5.0.0.0'" — the package could not be installed at
         all. 4.14.0 loads in the .NET 8, 9 and 10 SDK compilers alike, and the analyzer only uses
         long-stable APIs (DiagnosticAnalyzer, SemanticModel, SyntaxKind). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Pinned above the vulnerable 2.0.0 that Microsoft.AspNetCore.OpenApi resolves transitively. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.5" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <!-- Pinned above the 2025.1.0 that Testcontainers resolves transitively, which carries
         GHSA-q939-rpr3-3284 (high: ScpClient recursive download allows arbitrary file write via
         server-controlled SCP filenames, affected <= 2025.1.0, first patched 2026.0.0). Testcontainers
         uses SSH.NET only for its remote-Docker-over-SSH transport, which this repository never
         exercises — the Redis containers are local — but NuGet audit is an error here, so the
         resolved version has to be clean regardless of whether the vulnerable path is reachable. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Internal cache engine (v3.0.0). Never surfaced to consumer applications as a setup concern:
         Caching.NET owns registration, configuration, logging categories, metric/meter names and branding. -->
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.NeueccMessagePack" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
  </ItemGroup>
</Project>
